# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Record, replay and statistically compare AI agent runs"
description:
  "bactrian runs AI agents written in any language as black-box subprocesses, records their model, tool and network traffic, replays it deterministically, and compares agent versions with confidence intervals."
maintainer: ["Antoni Wuczynski <antoni.wuczynski@gmail.com>"]
authors: ["Antoni Wuczynski"]
license: "Apache-2.0"
homepage: "https://github.com/AntoniWuczynski/bactrian"
bug-reports: "https://github.com/AntoniWuczynski/bactrian/issues"
depends: [
  "dune" {>= "3.24"}
  "ocaml" {>= "5.5"}
  "cmdliner" {>= "2.1.1"}
  "yojson" {>= "3.0.0"}
  "ppx_deriving_yojson" {>= "3.10.0"}
  "re" {>= "1.14.0"}
  "alcotest" {with-test}
  "qcheck-core" {with-test}
  "qcheck-alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/AntoniWuczynski/bactrian.git"
x-maintenance-intent: ["(latest)"]

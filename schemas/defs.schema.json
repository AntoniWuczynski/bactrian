{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AntoniWuczynski/bactrian/main/schemas/defs.schema.json",
  "title": "Shared definitions",
  "description": "Building blocks the other schemas refer to. Not a file format of its own.",
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "non_negative_integer": { "type": "integer", "minimum": 0 },
    "number_or_null": {
      "description": "A statistic: non-finite values are written as null.",
      "type": ["number", "null"]
    },
    "string_or_null": { "type": ["string", "null"] },
    "string_list": { "type": "array", "items": { "type": "string" } },
    "string_map": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "string_pairs": {
      "description": "An ordered list of [key, value] pairs.",
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [{ "type": "string" }, { "type": "string" }],
        "items": false,
        "minItems": 2
      }
    },
    "sha256_hex": {
      "description": "A BLAKE2b-256 or SHA-256 digest: 64 lower-case hexadecimal digits.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rfc3339": {
      "description": "An RFC 3339 date and time.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt ][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "duration": {
      "description": "A positive number of seconds, or a positive number with the unit ms, s or m, such as \"250ms\", \"120s\" or \"2m\".",
      "oneOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        {
          "type": "string",
          "pattern": "^(?=[0.]*[1-9])([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ms|s|m)$"
        }
      ]
    },
    "regex": {
      "description": "A regular expression in the dialect bactrian compiles (RE2-like, no look-around or back-references).",
      "type": "string"
    },
    "provider": { "enum": ["openai", "anthropic", "gemini", "openrouter"] },
    "policy": { "enum": ["record", "replay", "passthrough", "block"] },
    "clock_name": { "enum": ["enforced", "contract_only"] },
    "version_1": { "const": 1 }
  }
}

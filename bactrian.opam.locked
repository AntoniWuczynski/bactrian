opam-version: "2.0"
name: "bactrian"
version: "dev"
synopsis: "Record, replay and statistically compare AI agent runs"
description:
  "bactrian runs AI agents written in any language as black-box subprocesses, records their model, tool and network traffic, replays it deterministically, and compares agent versions with confidence intervals."
maintainer: "Antoni Wuczynski <antoni.wuczynski@gmail.com>"
authors: "Antoni Wuczynski"
license: "Apache-2.0"
homepage: "https://github.com/AntoniWuczynski/bactrian"
bug-reports: "https://github.com/AntoniWuczynski/bactrian/issues"
depends: [
  "alcotest" {= "1.9.1" & with-test}
  "angstrom" {= "0.16.1"}
  "astring" {= "0.8.5" & with-test}
  "base" {= "v0.17.3"}
  "base-bigarray" {= "base"}
  "base-bytes" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "base64" {= "3.5.2"}
  "bigstringaf" {= "0.10.0"}
  "camlp-streams" {= "5.0.1" & with-doc}
  "cmdliner" {= "2.1.1"}
  "cohttp" {= "dev"}
  "cohttp-eio" {= "dev"}
  "compiler-cloning" {= "enabled"}
  "cppo" {= "1.8.0"}
  "crunch" {= "4.1.0" & with-doc}
  "csexp" {= "1.5.2"}
  "cstruct" {= "6.3.0"}
  "digestif" {= "1.3.1"}
  "domain-local-await" {= "1.0.1"}
  "domain-name" {= "0.5.0"}
  "dune" {= "3.24.2"}
  "dune-configurator" {= "3.24.2"}
  "duration" {= "0.3.1"}
  "eio" {= "1.6"}
  "eio_main" {= "1.6"}
  "eio_posix" {= "1.6"}
  "eqaf" {= "0.10"}
  "fmt" {= "0.11.0"}
  "fpath" {= "0.7.3" & with-doc}
  "gen" {= "1.1"}
  "hmap" {= "0.8.1"}
  "http" {= "dev"}
  "iomux" {= "0.4"}
  "ipaddr" {= "5.6.2"}
  "js_of_ocaml-compiler" {= "6.4.1"}
  "logs" {= "0.10.0"}
  "lwt" {= "6.1.2"}
  "lwt-dllist" {= "1.1.0"}
  "macaddr" {= "5.6.2"}
  "menhir" {= "20260209"}
  "menhirCST" {= "20260209"}
  "menhirGLR" {= "20260209"}
  "menhirLib" {= "20260209"}
  "menhirSdk" {= "20260209"}
  "mirage-crypto" {= "2.4.1"}
  "mirage-crypto-rng" {= "2.4.1"}
  "mtime" {= "2.2.0"}
  "ocaml" {= "5.5.1"}
  "ocaml-base-compiler" {= "5.5.1"}
  "ocaml-compiler" {= "5.5.1"}
  "ocaml-compiler-libs" {= "v0.17.0"}
  "ocaml-options-vanilla" {= "1"}
  "ocaml-syntax-shims" {= "1.0.0"}
  "ocaml_intrinsics_kernel" {= "v0.17.2"}
  "ocamlbuild" {= "0.16.1"}
  "ocamlfind" {= "1.9.9~preview"}
  "ocplib-endian" {= "1.2"}
  "odoc" {= "3.2.1" & with-doc}
  "odoc-parser" {= "3.2.1" & with-doc}
  "optint" {= "0.3.0"}
  "ppx_derivers" {= "1.2.1"}
  "ppx_deriving" {= "6.2.0"}
  "ppx_deriving_yojson" {= "3.10.0"}
  "ppx_sexp_conv" {= "v0.17.1"}
  "ppxlib" {= "0.39.0"}
  "ppxlib_jane" {= "v0.17.4"}
  "psq" {= "0.2.1"}
  "ptime" {= "1.2.0"}
  "qcheck-alcotest" {= "0.91" & with-test}
  "qcheck-core" {= "0.91" & with-test}
  "qcheck-multicoretests-util" {= "0.10" & with-test}
  "qcheck-stm" {= "0.10" & with-test}
  "re" {= "1.14.0"}
  "sedlex" {= "3.8.1"}
  "seq" {= "base"}
  "sexplib0" {= "v0.17.0"}
  "stdlib-shims" {= "0.3.0" & with-test}
  "stringext" {= "1.6.0"}
  "thread-table" {= "1.0.0"}
  "topkg" {= "1.1.1"}
  "tyxml" {= "5.0.0" & with-doc}
  "uri" {= "4.4.0"}
  "uri-sexp" {= "4.4.0"}
  "uutf" {= "1.0.4" & with-test}
  "yojson" {= "3.0.0"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/AntoniWuczynski/bactrian.git"
x-maintenance-intent: ["(latest)"]
pin-depends: [
  [
    "cohttp.dev"
    "git+https://github.com/mirage/ocaml-cohttp.git#1193aaeef7dcb9590e999ea9ed455c3649d7bc15"
  ]
  [
    "cohttp-eio.dev"
    "git+https://github.com/mirage/ocaml-cohttp.git#1193aaeef7dcb9590e999ea9ed455c3649d7bc15"
  ]
  [
    "http.dev"
    "git+https://github.com/mirage/ocaml-cohttp.git#1193aaeef7dcb9590e999ea9ed455c3649d7bc15"
  ]
]
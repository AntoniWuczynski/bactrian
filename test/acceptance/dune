; The real example agents against a scripted fake upstream. The agents run from
; the source tree (node_modules and the uv environment live there); the deps
; make dune rerun the test when their sources change. dist/agent.js is built by
; `pnpm --dir examples/agents/typescript build`.

(executables
 (names test_acceptance test_launch_env_outside test_mcp_client)
 (libraries
  bactrian.core
  mcp_client
  bactrian.app
  bactrian.runtime
  fake_upstream
  denials
  eio_main
  mirage-crypto-rng.unix
  unix
  uri
  yojson
  alcotest)
 (flags
  (:standard -w -70)))

; Not part of `dune test`: it needs node, uv and the built TypeScript agent.
; Run it with `dune build @acceptance`. dune sets DUNE_SOURCEROOT to the
; repository root in every action, whatever the build directory.

(rule
 (alias acceptance)
 (deps
  (source_tree ../fixtures/protocols/openai_chat)
  ../../examples/agents/typescript/src/agent.ts
  ../../examples/agents/typescript/dist/agent.js
  ../../examples/agents/python/agent.py
  ../../examples/agents/python/pyproject.toml
  ../../examples/agents/python/uv.lock
  ../sandbox/escape.mts
  ../sandbox/escape.py)
 (action
  (setenv
   BACTRIAN_EXE
   %{exe:../../bin/main.exe}
   (setenv
    FAKE_MCP_SERVER
    %{exe:../support/fake_mcp/fake_mcp_server.exe}
    (progn
     (run %{exe:test_acceptance.exe})
     ; bactrian serve-mcp from the outside, with a scripted client.
     (run %{exe:test_mcp_client.exe}))))))

; The launch environments of bactrian and its children, read from outside
; while a sandboxed run is live. Needs python3.

(rule
 (alias acceptance)
 (action
  (setenv
   BACTRIAN_EXE
   %{exe:../../bin/main.exe}
   (run %{exe:test_launch_env_outside.exe}))))

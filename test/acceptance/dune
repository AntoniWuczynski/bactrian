; The real example agents against a scripted fake upstream. The agents run from
; the source tree (node_modules and the uv environment live there); the deps
; make dune rerun the test when their sources change. dist/agent.js is built by
; `pnpm --dir examples/agents/typescript build`.

(executables
 (names
  gen_schema_samples
  test_acceptance
  test_launch_env_outside
  test_mcp_client
  test_upstream_override
  test_vm)
 (libraries
  bactrian.core
  mcp_client
  bactrian.app
  bactrian.runtime
  fake_upstream
  weather_agent
  denials
  eio_main
  mirage-crypto-rng.unix
  unix
  uri
  yojson
  alcotest)
 (flags
  (:standard -w -70)))

; Not part of `dune test`: it needs node, uv and the built TypeScript agent.
; Run it with `dune build @acceptance`. dune sets DUNE_SOURCEROOT to the
; repository root in every action, whatever the build directory.

(rule
 (alias acceptance)
 (deps
  (source_tree ../fixtures/protocols/openai_chat)
  ../../examples/agents/typescript/src/agent.ts
  ../../examples/agents/typescript/dist/agent.js
  ../../examples/agents/python/agent.py
  ../../examples/agents/python/pyproject.toml
  ../../examples/agents/python/uv.lock
  ../sandbox/escape.mts
  ../sandbox/escape.py)
 (action
  (setenv
   BACTRIAN_EXE
   %{exe:../../bin/main.exe}
   (setenv
    FAKE_MCP_SERVER
    %{exe:../support/fake_mcp/fake_mcp_server.exe}
    (setenv
     FAKE_UPSTREAM_SERVER
     %{exe:../support/fake_upstream/fake_upstream_server.exe}
     (progn
      (run %{exe:test_acceptance.exe})
      ; bactrian serve-mcp from the outside, with a scripted client.
      (run %{exe:test_mcp_client.exe})
      ; Experiments through BACTRIAN_UPSTREAM_*, against a fake upstream process.
      (run %{exe:test_upstream_override.exe})))))))

; The launch environments of bactrian and its children, read from outside
; while a sandboxed run is live. Needs python3.

(rule
 (alias acceptance)
 (action
  (setenv
   BACTRIAN_EXE
   %{exe:../../bin/main.exe}
   (run %{exe:test_launch_env_outside.exe}))))

; The virtual machine sandbox, on docker, or on Apple's container when
; BACTRIAN_VM_RUNTIME is container. Skipped without the runtime, unless
; BACTRIAN_REQUIRE_VM is 1. Needs the network once, for the images,
; the relay's build and the Python agent's packages.

(rule
 (alias acceptance)
 (deps
  ../../examples/agents/typescript/dist/agent.js
  ../../examples/agents/python/agent.py
  ../../examples/agents/python/pyproject.toml
  ../../examples/agents/python/uv.lock
  ../sandbox/escape.mts
  ../sandbox/escape.py
  (source_tree ../fixtures/protocols/openai_chat)
  (env_var BACTRIAN_REQUIRE_VM)
  (env_var BACTRIAN_VM_RUNTIME))
 (action
  (setenv
   BACTRIAN_EXE
   %{exe:../../bin/main.exe}
   (run %{exe:test_vm.exe}))))

; The JSON Schemas in schemas/ against real files. The binary under test runs an
; experiment, a diverging replay, compare, plan and check against a fake
; upstream, and dev/schemas/validate.py (a uv project, `uv sync --locked` first)
; validates everything they left behind, then the hand-written fixtures, then
; mutated copies that must be rejected. Needs python3 for the agent and uv.
; Run it with `dune build @schemas`. `uv run --locked` creates or syncs
; dev/schemas/.venv in the source tree, outside _build, which is gitignored.

(rule
 (alias schemas)
 (deps
  (source_tree ../fixtures/protocols/openai_chat)
  (source_tree ../../schemas)
  (source_tree ../../dev/schemas/fixtures)
  ../../dev/schemas/validate.py
  ../../dev/schemas/pyproject.toml
  ../../dev/schemas/uv.lock)
 (action
  (setenv
   BACTRIAN_EXE
   %{exe:../../bin/main.exe}
   (setenv
    FAKE_UPSTREAM_SERVER
    %{exe:../support/fake_upstream/fake_upstream_server.exe}
    (progn
     (run
      %{exe:gen_schema_samples.exe}
      schema-samples
      ../../dev/schemas/fixtures)
     (run
      uv
      run
      --locked
      --project
      %{env:DUNE_SOURCEROOT=.}/dev/schemas
      python
      %{env:DUNE_SOURCEROOT=.}/dev/schemas/validate.py
      --schemas
      ../../schemas
      --samples
      schema-samples
      --fixtures
      ../../dev/schemas/fixtures))))))
